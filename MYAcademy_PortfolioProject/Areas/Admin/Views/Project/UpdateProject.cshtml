@model Project
@{
    ViewData["Title"] = "Projeyi Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Projeyi Güncelle</h1>
            <p class="page-subtitle">@Model.ProjectTitle</p>
        </div>
    </div>

    <div class="form-card" style="max-width: 1100px;">
        <form asp-action="UpdateProject" method="post" enctype="multipart/form-data">
            <partial name="_ProjectForm" model="Model" />
            <div class="form-actions">
                <a asp-action="ProjectList" class="btn-pastel-secondary text-decoration-none">Vazgeç</a>
                <button type="submit" class="btn-pastel-primary"><i class="bi bi-check-lg"></i> <span>Güncelle</span></button>
            </div>
        </form>
    </div>
</main>
