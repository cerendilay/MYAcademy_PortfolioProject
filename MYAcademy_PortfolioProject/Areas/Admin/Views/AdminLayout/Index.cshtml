<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")
<body>

<div class="admin-wrapper">

    <!-- ==================== 1. LEFT SIDEBAR ==================== -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

    <!-- ==================== 2. MAIN CONTENT AREA ==================== -->
    <div class="admin-main">

        <!-- TOP NAVBAR -->
        @await Component.InvokeAsync("_AdminLayoutNavbarComponentPartial")

        @RenderBody()
    </div>
</div>

<!-- ==================== TOAST NOTIFICATION ==================== -->
<!-- Controller'da TempData["Success"] / TempData["Error"] atanırsa sayfa açılınca bildirim gösterilir -->
<div class="toast-pill-success" id="actionToast"
     data-success="@TempData["Success"]" data-error="@TempData["Error"]">
    <i class="bi bi-check-circle-fill text-success" style="font-size: 1.25rem;" id="toastIcon"></i>
    <div>
        <div style="font-weight:600; font-size:0.85rem;" id="toastTitle">Başarılı</div>
        <div style="font-size:0.775rem; color:var(--text-secondary);" id="toastMsg">İşlem başarıyla gerçekleştirildi.</div>
    </div>
</div>

<!-- Kütüphaneler -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>

<!-- Ortak admin scriptleri (sidebar, toast, silme onayı) -->
@await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")

<!-- Sayfaya özel scriptler -->
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
