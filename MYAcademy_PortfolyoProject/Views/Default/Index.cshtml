@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
<body>

  <!-- Fixed Navigation Bar -->
    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")

  <main>
    <!-- 4. Hero Section -->
        @await Component.InvokeAsync("_DefaultHeroSectionComponentPartial")

    <!-- 5. About Me Section -->
    @await Component.InvokeAsync("_DefaultAboutComponentPartial")

    <!-- 6. Skills Section -->
    @await Component.InvokeAsync("_DefaultSkillComponentPartial")

    <!-- 7. Professional Experience Section -->
        @await Component.InvokeAsync("_DefaultExperienceComponentPartial")

    <!-- 8. Featured Projects Section -->
    @await Component.InvokeAsync("_DefaultProjectComponentPartial")

    <!-- 9. Education Section -->
    @await Component.InvokeAsync("_DefaultEducationComponentPartial")

    <!-- 10. Personal Philosophy Section -->
    <section class="philosophy-section text-center">
      <div class="container">
        <div class="mx-auto reveal-on-scroll" style="max-width: 820px;">
          <div class="mb-3 text-secondary" style="font-size: 2.5rem; line-height: 1;">
            <i class="bi bi-code-slash text-light opacity-50"></i>
          </div>
          <p class="philosophy-quote mb-4">
            "İyi yazılım yalnızca çalışan kod değil, gerçek bir probleme üretilmiş anlamlı bir çözümdür."
          </p>
          <div class="d-inline-flex align-items-center gap-2 text-white-50 small font-heading">
            <span class="w-12 h-px bg-white-50"></span>
            <span>Ceren Dilay Velioğlu — Yazılım Felsefesi</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 11. Contact Section -->
    @await Component.InvokeAsync("_DefaultContactComponentPartial")
  </main>

  <!-- 12. Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="d-flex flex-column flex-md-row align-items-center justify-content-between pb-4 border-bottom gap-3">
        <div>
          <a class="navbar-brand-custom" href="#home">
            <span>Ceren Dilay Velioğlu.</span>
          </a>
          <p class="text-muted small mb-0 mt-1">Kod, yaratıcılık ve sürekli öğrenme.</p>
        </div>

        <!-- Quick Links -->
        <div class="d-flex gap-3">
          <a href="#home" class="text-decoration-none text-muted small fw-medium">Ana Sayfa</a>
          <a href="#about" class="text-decoration-none text-muted small fw-medium">Hakkımda</a>
          <a href="#projects" class="text-decoration-none text-muted small fw-medium">Projelerim</a>
          <a href="#contact" class="text-decoration-none text-muted small fw-medium">İletişim</a>
        </div>

        <button class="back-to-top-btn" id="backToTop" title="Yukarı Çık">
          <i class="bi bi-arrow-up"></i>
        </button>
      </div>

      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-3 gap-2">
        <div class="text-muted small">
          © 2026 Ceren Dilay Velioğlu. Tüm hakları saklıdır.
        </div>
        <div class="d-flex gap-2">
          @await Component.InvokeAsync("_DefaultSocialMediaComponentPartial", new { variant = "footer" })
        </div>
      </div>
    </div>
  </footer>

  <!-- Bootstrap 5 JS Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Vanilla JavaScript for Interactivity -->
  <script>
    // 1. Typewriter Animation for Hero Section
    (function initTypewriter() {
      const targetElement = document.getElementById("typewriterText");
      if (!targetElement) return;
      // Unvanlar veritabanındaki HeroTitles tablosundan gelir (hero view component'i data-phrases'e yazar)
      let phrases = [];
      try { phrases = JSON.parse(targetElement.dataset.phrases || "[]"); } catch (e) { }
      if (!phrases.length) return;

      let phraseIndex = 0;
      let charIndex = 0;
      let isDeleting = false;
      const typeSpeed = 80;
      const deleteSpeed = 40;
      const delayBetween = 1800;

      function typeCycle() {
        const currentPhrase = phrases[phraseIndex];
        if (isDeleting) {
          targetElement.textContent = currentPhrase.substring(0, charIndex - 1);
          charIndex--;
        } else {
          targetElement.textContent = currentPhrase.substring(0, charIndex + 1);
          charIndex++;
        }

        if (!isDeleting && charIndex === currentPhrase.length) {
          setTimeout(() => {
            isDeleting = true;
            typeCycle();
          }, delayBetween);
          return;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          setTimeout(typeCycle, 300);
          return;
        }

        setTimeout(typeCycle, isDeleting ? deleteSpeed : typeSpeed);
      }

      typeCycle();
    })();

    // 2. Fixed Navbar on Scroll
    window.addEventListener("scroll", function() {
      const navbar = document.getElementById("mainNavbar");
      if (window.scrollY > 40) {
        navbar.classList.add("scrolled");
      } else {
        navbar.classList.remove("scrolled");
      }
    });

    // 3. Active Nav Link on Scroll Spy
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll(".nav-link-custom");

    function updateActiveNav() {
      const scrollY = window.pageYOffset;
      sections.forEach(current => {
        const sectionHeight = current.offsetHeight;
        const sectionTop = current.offsetTop - 120;
        const sectionId = current.getAttribute("id");

        if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
          navLinks.forEach(link => {
            link.classList.remove("active");
            if (link.getAttribute("href") === "#" + sectionId) {
              link.classList.add("active");
            }
          });
        }
      });
    }
    window.addEventListener("scroll", updateActiveNav);

    // 4. Mobile Menu Auto-close on click
    document.querySelectorAll(".mobile-nav-link").forEach(link => {
      link.addEventListener("click", () => {
        const mobileMenu = document.getElementById("mobileMenu");
        if (mobileMenu && mobileMenu.classList.contains("show")) {
          const bsCollapse = bootstrap.Collapse.getInstance(mobileMenu);
          if (bsCollapse) bsCollapse.hide();
        }
      });
    });

    // 5. Proje filtreleme ve sıralama _DefaultProjectComponentPartial içinde yapılıyor.

    // 6. Back to Top Button
    const backToTopBtn = document.getElementById("backToTop");
    if (backToTopBtn) {
      backToTopBtn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }

    // 7. Intersection Observer for Scroll Reveals
    const revealElements = document.querySelectorAll(".reveal-on-scroll");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-revealed");
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: "0px 0px -40px 0px"
    });

    revealElements.forEach(el => observer.observe(el));

    // 8. İletişim formu gönderimi _DefaultContactComponentPartial içinde yapılıyor.
  </script>
</body>
</html>
