@model List<Category>
@{
    ViewData["Title"] = "Proje Kategorileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Proje Kategorileri</h1>
            <p class="page-subtitle">Projeler bu kategorilere bağlanır; sitede filtre butonu olarak görünür.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateCategory" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i> <span>Yeni Kategori</span>
            </a>
        </div>
    </div>

    <div class="data-table-card" style="max-width: 760px;">
        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th>Kategori</th>
                        <th style="width: 140px;">Proje Sayısı</th>
                        <th style="text-align: right; width: 120px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet"><i class="bi bi-tag"></i></div>
                                    <span class="exp-title-text">@item.CategoryName</span>
                                </div>
                            </td>
                            <td>
                                <a asp-controller="Project" asp-action="ProjectList" asp-route-categoryId="@item.CategoryId"
                                   class="order-badge text-decoration-none" title="Bu kategorinin projelerini gör">@item.Projects.Count</a>
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateCategory" asp-route-id="@item.CategoryId" class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteCategory" asp-route-id="@item.CategoryId" method="post"
                                          class="js-confirm-delete d-inline" data-item-name="@item.CategoryName">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil"><i class="bi bi-trash3"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="empty-state"><i class="bi bi-tags"></i>Henüz kategori eklenmemiş.</div>
            }
        </div>
    </div>
</main>
