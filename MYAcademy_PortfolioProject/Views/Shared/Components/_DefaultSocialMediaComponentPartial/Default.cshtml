@model List<MYAcademy_PortfolioProject.Entities.SocialMedia>
@{
    bool isFooter = ViewBag.Variant == "footer";
}

@foreach (var item in Model)
{
    if (isFooter)
    {
        <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="text-muted small text-decoration-none me-2">
            <i class="bi @item.Icon"></i> @item.Name
        </a>
    }
    else
    {
        <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="social-pill" title="@item.Name">
            <i class="bi @item.Icon"></i>
        </a>
    }
}
