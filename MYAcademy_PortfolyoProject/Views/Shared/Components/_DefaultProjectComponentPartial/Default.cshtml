@model List<MYAcademy_PortfolyoProject.Entities.Project>
@{
    var categories = ViewBag.Categories as List<MYAcademy_PortfolyoProject.Entities.Category> ?? new();
}

<section id="projects">
    <div class="container">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>
                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>
                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <div class="d-flex flex-column align-items-start align-items-lg-end gap-2">
                <!-- Kategori filtreleri (veritabanındaki kategorilerden) -->
                <div class="d-flex flex-wrap gap-2" id="projectFilters">
                    <button type="button" class="filter-btn active" data-filter="all">Tümü</button>
                    @foreach (var category in categories)
                    {
                        <button type="button" class="filter-btn" data-filter="@category.CategoryId">@category.CategoryName</button>
                    }
                </div>
                <!-- Sıralama -->
                <select id="projectSort" class="form-select form-select-sm w-auto" aria-label="Projeleri sırala">
                    <option value="newest">En yeni proje</option>
                    <option value="oldest">En eski proje</option>
                    <option value="title">Ada göre (A-Z)</option>
                </select>
            </div>
        </div>

        <div class="row g-4" id="projectGrid">
            @foreach (var item in Model)
            {
                <div class="col-lg-6 project-item reveal-on-scroll"
                     data-category="@item.CategoryId"
                     data-date="@item.ProjectDate?.ToString("yyyy-MM-dd")"
                     data-title="@item.ProjectTitle">
                    <div class="project-card">
                        <div class="project-thumb-wrap">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.ProjectTitle" class="project-thumb-img" loading="lazy">
                            }
                            else
                            {
                                <div class="project-thumb-img d-flex align-items-center justify-content-center"
                                     style="background: linear-gradient(135deg, var(--accent-sage-soft), var(--accent-terracotta-soft));">
                                    <i class="bi bi-code-square" style="font-size: 3.5rem; color: var(--accent-sage-dark); opacity: .6;"></i>
                                </div>
                            }
                            <span class="project-category-tag">@item.Category?.CategoryName</span>
                        </div>
                        <div class="project-body">
                            <div class="text-muted small mb-1"><i class="bi bi-calendar3 me-1"></i>@item.ProjectDate?.ToString("MMMM yyyy")</div>
                            <h3 class="h4 fw-bold mb-2">@item.ProjectTitle</h3>
                            <p class="text-muted small mb-4 flex-grow-1">@item.Description</p>
                            <div class="mb-4">
                                @foreach (var tech in item.GetTechnologyList())
                                {
                                    <span class="tech-badge">@tech</span>
                                }
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top gap-2 flex-wrap">
                                @if (!string.IsNullOrEmpty(item.LiveUrl))
                                {
                                    <a href="@item.LiveUrl" target="_blank" rel="noopener noreferrer" class="btn-sage btn-sm">
                                        <span>Canlı Demo</span> <i class="bi bi-arrow-up-right"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer" class="btn-secondary-custom btn-sm">
                                        <i class="bi bi-github"></i> <span>GitHub</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-lock me-1"></i>Kaynak kod paylaşılmadı</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <p class="text-muted text-center">Projeler yakında eklenecek.</p>
        }
        <p class="text-muted text-center d-none" id="projectEmptyFilter">Bu kategoride proje bulunmuyor.</p>
    </div>
</section>

<script>
    // Kategori filtresi ve sıralama sayfa yenilenmeden tarayıcıda yapılır.
    (function () {
        const grid = document.getElementById('projectGrid');
        const buttons = document.querySelectorAll('#projectFilters .filter-btn');
        const sortSelect = document.getElementById('projectSort');
        const emptyText = document.getElementById('projectEmptyFilter');
        if (!grid) return;

        function applyFilter(filterValue) {
            let visible = 0;
            grid.querySelectorAll('.project-item').forEach(item => {
                const show = filterValue === 'all' || item.dataset.category === filterValue;
                item.style.display = show ? '' : 'none';
                if (show) { item.classList.add('is-revealed'); visible++; }
            });
            emptyText.classList.toggle('d-none', visible > 0);
        }

        function applySort(sortValue) {
            const items = Array.from(grid.querySelectorAll('.project-item'));
            items.sort((a, b) => {
                if (sortValue === 'title') return a.dataset.title.localeCompare(b.dataset.title, 'tr');
                if (sortValue === 'oldest') return a.dataset.date.localeCompare(b.dataset.date);
                return b.dataset.date.localeCompare(a.dataset.date); // newest
            });
            items.forEach(item => grid.appendChild(item));
        }

        buttons.forEach(btn => btn.addEventListener('click', () => {
            buttons.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilter(btn.dataset.filter);
        }));

        sortSelect.addEventListener('change', () => applySort(sortSelect.value));
    })();
</script>
