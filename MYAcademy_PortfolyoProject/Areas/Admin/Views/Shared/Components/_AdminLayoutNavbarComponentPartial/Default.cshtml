<header class="admin-navbar">
    <div class="navbar-left">
        <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Menüyü Aç/Kapat">
            <i class="bi bi-list"></i>
        </button>
        <div class="breadcrumb-custom">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-house me-1"></i> Panel</a>
            <span class="separator">/</span>
            <span class="active-crumb">@ViewData["Title"]</span>
        </div>
    </div>

    <div class="navbar-right">
        <!-- Hızlı erişim: mesajlar -->
        <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="icon-action-btn" title="Gelen Kutusu">
            <i class="bi bi-chat-left-text"></i>
        </a>

        <!-- Siteyi yeni sekmede aç -->
        <a asp-area="" asp-controller="Default" asp-action="Index" target="_blank" class="icon-action-btn" title="Siteyi Önizle">
            <i class="bi bi-box-arrow-up-right"></i>
        </a>

        <!-- Admin Profile Pill -->
        <div class="nav-profile-pill">
            <div class="nav-avatar-mini">CD</div>
            <span class="d-none d-sm-inline" style="font-size:0.825rem; font-weight:600;">Admin</span>
        </div>
    </div>
</header>
