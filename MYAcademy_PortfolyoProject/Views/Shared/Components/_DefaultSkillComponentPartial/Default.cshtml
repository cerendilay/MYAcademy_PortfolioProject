@model List<MYAcademy_PortfolyoProject.Entities.Skill>

<section id="skills">
    <div class="container">
        <div class="section-header text-center mx-auto reveal-on-scroll" style="max-width: 680px;">
            <div class="eyebrow-badge">
                <i class="bi bi-stack"></i> TEKNOLOJİ YIĞINIM
            </div>
            <h2 class="section-title">
                Kullandığım Teknolojiler ve Yetkinliklerim
            </h2>
            <p class="section-description mx-auto">
                Mobil arayüzden backend servislerine, veritabanından yapay zekâ entegrasyonlarına kadar çalıştığım teknolojiler ve seviyelerim.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var skill in Model)
            {
                <div class="col-md-6 reveal-on-scroll">
                    <div class="skill-card h-100">
                        <div class="skill-icon-box">
                            <i class="bi @skill.IconUrl"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-2">@skill.Title</h3>
                        <p class="text-muted small mb-4">@skill.Description</p>

                        <!-- Her yetenek: ad + seviye çubuğu (0-100) -->
                        <div class="row g-3">
                            @foreach (var item in skill.SkillItems.OrderByDescending(x => x.Level))
                            {
                                <div class="col-sm-6">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="fw-semibold">@item.SkillItemTitle</span>
                                        <span class="text-muted">%@item.Level</span>
                                    </div>
                                    <div class="skill-level-track" role="progressbar" aria-label="@item.SkillItemTitle"
                                         aria-valuenow="@item.Level" aria-valuemin="0" aria-valuemax="100">
                                        <div class="skill-level-fill" style="width: @item.Level%;"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
