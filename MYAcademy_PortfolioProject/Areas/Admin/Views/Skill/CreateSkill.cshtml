@model Skill
@{
    ViewData["Title"] = "Yeni Yetenek Grubu";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<main class="page-content-area">
    <div class="content-header-row">
        <div>
            <h1 class="page-title">Yeni Yetenek Grubu</h1>
            <p class="page-subtitle">Örn: "Backend & Veritabanı", "Mobil & Frontend".</p>
        </div>
    </div>

    <div class="form-card">
        <form asp-action="CreateSkill" method="post">
            <partial name="_SkillForm" model="Model" />
            <div class="form-actions">
                <a asp-action="SkillList" class="btn-pastel-secondary text-decoration-none">Vazgeç</a>
                <button type="submit" class="btn-pastel-primary"><i class="bi bi-check-lg"></i> <span>Kaydet</span></button>
            </div>
        </form>
    </div>
</main>
