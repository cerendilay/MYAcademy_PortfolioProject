@model Skill

<div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
<input type="hidden" asp-for="SkillId" />

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label-custom">Grup Adı <span class="required-star">*</span></label>
        <input asp-for="Title" class="form-control-custom" placeholder="Örn: Backend & Veritabanı" />
        <span asp-validation-for="Title"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DisplayOrder" class="form-label-custom">Sıra</label>
        <input asp-for="DisplayOrder" type="number" class="form-control-custom" />
        <span asp-validation-for="DisplayOrder"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label-custom">Açıklama <span class="required-star">*</span></label>
        <input asp-for="Description" class="form-control-custom" placeholder="Kartın altında görünen kısa açıklama" />
        <span asp-validation-for="Description"></span>
    </div>
    <div class="col-12">
        <label class="form-label-custom">İkon <span class="required-star">*</span></label>
        <partial name="_IconPicker" model="Model.IconUrl" view-data='new ViewDataDictionary(ViewData) { ["FieldName"] = "IconUrl" }' />
        <span asp-validation-for="IconUrl"></span>
    </div>
</div>
