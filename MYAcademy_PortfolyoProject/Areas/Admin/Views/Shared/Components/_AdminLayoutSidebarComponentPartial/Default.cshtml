@{
    string active = ViewBag.ActiveController ?? "";
    int unreadCount = ViewBag.UnreadMessageCount ?? 0;

    // Menüde gösterilecek linkler: (Controller, Action, İkon, Başlık)
    var menuItems = new[]
    {
        (Controller: "Dashboard",  Action: "Index",          Icon: "bi-grid-1x2",              Text: "Dashboard"),
        (Controller: "About",      Action: "Index",          Icon: "bi-person",                Text: "Hakkımda"),
        (Controller: "Skill",      Action: "SkillList",      Icon: "bi-stars",                 Text: "Yeteneklerim"),
        (Controller: "Experience", Action: "ExperienceList", Icon: "bi-journal-bookmark-fill", Text: "Deneyimlerim"),
        (Controller: "Project",    Action: "ProjectList",    Icon: "bi-code-slash",            Text: "Projelerim"),
        (Controller: "Category",   Action: "CategoryList",   Icon: "bi-tags",                  Text: "Proje Kategorileri"),
        (Controller: "Education",  Action: "EducationList",  Icon: "bi-mortarboard",           Text: "Eğitim"),
        (Controller: "Contact",    Action: "ContactList",    Icon: "bi-envelope",              Text: "İletişim & Sosyal Medya"),
        (Controller: "Message",    Action: "MessageList",    Icon: "bi-inbox",                 Text: "Gelen Kutusu"),
    };
}

<aside class="admin-sidebar" id="adminSidebar">
    <!-- Brand Header -->
    <div class="sidebar-header">
        <div class="brand-mark">
            <i class="bi bi-briefcase-fill"></i>
        </div>
        <div class="brand-text">
            <h1>Ceren Dilay Velioğlu</h1>
            <span>Yönetim Paneli</span>
        </div>
    </div>

    <!-- Menu Links -->
    <div class="sidebar-menu-wrapper">
        <div class="menu-section-label">Menü</div>
        <ul class="sidebar-nav">
            @foreach (var item in menuItems)
            {
                <li>
                    <a asp-area="Admin" asp-controller="@item.Controller" asp-action="@item.Action"
                       class="sidebar-link @(active == item.Controller ? "active" : "")">
                        <i class="bi @item.Icon"></i>
                        <span>@item.Text</span>
                        @if (item.Controller == "Message" && unreadCount > 0)
                        {
                            <span class="badge-count" title="Okunmamış mesaj">@unreadCount</span>
                        }
                    </a>
                </li>
            }
        </ul>

        <div class="menu-section-label mt-4">Sistem & Bağlantı</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-area="" asp-controller="Default" asp-action="Index" target="_blank" class="sidebar-link">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Siteyi Önizle</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Admin User Footer -->
    <div class="sidebar-footer">
        <div class="admin-user-card">
            <div class="user-avatar-circle">CD</div>
            <div class="user-info">
                <div class="user-name">Ceren Dilay</div>
                <div class="user-role">İçerik Yöneticisi</div>
            </div>
        </div>
    </div>
</aside>
