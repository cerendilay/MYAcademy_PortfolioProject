@model SocialMedia

<div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
<input type="hidden" asp-for="SocialMediaId" />

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label-custom">Platform <span class="required-star">*</span></label>
        <input asp-for="Name" class="form-control-custom" placeholder="Örn: GitHub" />
        <span asp-validation-for="Name"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DisplayOrder" class="form-label-custom">Sıra</label>
        <input asp-for="DisplayOrder" type="number" class="form-control-custom" />
        <span asp-validation-for="DisplayOrder"></span>
    </div>
    <div class="col-12">
        <label asp-for="Url" class="form-label-custom">Bağlantı (URL) <span class="required-star">*</span></label>
        <input asp-for="Url" class="form-control-custom" placeholder="https://github.com/kullaniciadi" />
        <span asp-validation-for="Url"></span>
    </div>
    <div class="col-12">
        <label class="form-label-custom">İkon <span class="required-star">*</span></label>
        <partial name="_IconPicker" model="Model.Icon" view-data='new ViewDataDictionary(ViewData) { ["FieldName"] = "Icon" }' />
        <span asp-validation-for="Icon"></span>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
            <label asp-for="IsActive" class="form-check-label">Sitede göster</label>
        </div>
    </div>
</div>
