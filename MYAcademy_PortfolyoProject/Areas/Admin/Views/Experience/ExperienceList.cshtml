@model List<Experience>
@{
    ViewData["Title"] = "Deneyimlerim";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int activeCount = Model.Count(x => x.IsActive);
}

<main class="page-content-area">

    <div class="content-header-row">
        <div>
            <h1 class="page-title">Deneyimlerim</h1>
            <p class="page-subtitle">Sitedeki "Deneyimlerim" bölümünde gösterilen kayıtları buradan yönetebilirsiniz.</p>
        </div>
        <div class="header-actions">
            <a asp-action="CreateExperience" class="btn-pastel-primary text-decoration-none">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Yeni Deneyim Ekle</span>
            </a>
        </div>
    </div>

    <!-- İstatistik kartları -->
    <div class="stats-row" style="grid-template-columns: repeat(3, 1fr);">
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-green"><i class="bi bi-briefcase"></i></div>
            <div class="stat-content">
                <span class="stat-label">Toplam Deneyim</span>
                <h3 class="stat-value">@Model.Count</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-blue"><i class="bi bi-check2-circle"></i></div>
            <div class="stat-content">
                <span class="stat-label">Sitede Görünen</span>
                <h3 class="stat-value">@activeCount</h3>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon-wrapper icon-beige"><i class="bi bi-pause-circle"></i></div>
            <div class="stat-content">
                <span class="stat-label">Gizli (Pasif)</span>
                <h3 class="stat-value">@(Model.Count - activeCount)</h3>
            </div>
        </div>
    </div>

    <div class="data-table-card">
        <!-- Arama / filtre -->
        <div class="table-filter-bar">
            <div class="filters-left-group">
                <div class="filter-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" id="tableSearchInput" placeholder="Unvan veya kuruma göre ara...">
                </div>
                <select class="filter-select" id="statusFilterSelect">
                    <option value="all">Durum (Tümü)</option>
                    <option value="Aktif">Aktif</option>
                    <option value="Pasif">Pasif</option>
                </select>
            </div>
        </div>

        <div class="table-responsive-wrapper">
            <table class="custom-admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">Sıra</th>
                        <th>Pozisyon / Unvan</th>
                        <th>Kurum / Şirket</th>
                        <th>Tür</th>
                        <th>Tarih Aralığı</th>
                        <th>Durum</th>
                        <th style="text-align: right; width: 120px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="experienceTableBody">
                    @foreach (var item in Model)
                    {
                        <tr data-status="@(item.IsActive ? "Aktif" : "Pasif")">
                            <td><span class="order-badge">@item.DisplayOrder</span></td>
                            <td>
                                <div class="experience-title-cell">
                                    <div class="exp-icon-bullet"><i class="bi bi-briefcase"></i></div>
                                    <span class="exp-title-text">@item.Title</span>
                                </div>
                            </td>
                            <td>
                                <div class="company-cell">
                                    <i class="bi bi-building company-badge-icon"></i>
                                    <span>@item.CompanyName</span>
                                </div>
                            </td>
                            <td><span class="work-type-badge">@item.CategoryName</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.Period))
                                {
                                    <span class="date-badge"><i class="bi bi-calendar2-range"></i> @item.Period</span>
                                }
                            </td>
                            <td>
                                <!-- Durum rozetine tıklayınca Aktif/Pasif değişir -->
                                <form asp-action="ToggleStatus" asp-route-id="@item.ExperienceId" method="post" class="d-inline">
                                    <button type="submit" class="border-0 bg-transparent p-0" title="Durumu değiştirmek için tıklayın">
                                        @if (item.IsActive)
                                        {
                                            <span class="status-pill status-active">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-passive">Pasif</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td style="text-align: right;">
                                <div class="row-actions-group justify-content-end">
                                    <a asp-action="UpdateExperience" asp-route-id="@item.ExperienceId"
                                       class="btn-action-icon btn-edit" title="Güncelle">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <form asp-action="DeleteExperience" asp-route-id="@item.ExperienceId" method="post"
                                          class="js-confirm-delete d-inline" data-item-name="@item.Title">
                                        <button type="submit" class="btn-action-icon btn-delete" title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-briefcase"></i>
                    Henüz deneyim eklenmemiş.
                </div>
            }
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Tablo içinde anlık arama ve durum filtresi (sayfa yenilenmeden)
        const searchInput = document.getElementById('tableSearchInput');
        const statusFilter = document.getElementById('statusFilterSelect');

        function filterExperienceTable() {
            const query = searchInput.value.toLocaleLowerCase('tr').trim();
            const status = statusFilter.value;

            document.querySelectorAll('#experienceTableBody tr').forEach(row => {
                const text = row.innerText.toLocaleLowerCase('tr');
                const matchesQuery = text.includes(query);
                const matchesStatus = status === 'all' || row.dataset.status === status;
                row.style.display = matchesQuery && matchesStatus ? '' : 'none';
            });
        }

        searchInput.addEventListener('input', filterExperienceTable);
        statusFilter.addEventListener('change', filterExperienceTable);
    </script>
}
