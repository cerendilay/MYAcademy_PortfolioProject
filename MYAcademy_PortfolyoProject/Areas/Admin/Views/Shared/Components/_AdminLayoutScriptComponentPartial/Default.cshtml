<script>
    // ---------- Mobil sidebar aç/kapat ----------
    const adminSidebar = document.getElementById('adminSidebar');
    const sidebarToggle = document.getElementById('sidebarToggle');

    if (sidebarToggle) {
        sidebarToggle.addEventListener('click', () => adminSidebar.classList.toggle('show-sidebar'));

        document.addEventListener('click', (e) => {
            if (window.innerWidth <= 991.98 &&
                !adminSidebar.contains(e.target) && !sidebarToggle.contains(e.target)) {
                adminSidebar.classList.remove('show-sidebar');
            }
        });
    }

    // ---------- Toast bildirimi ----------
    function showToast(title, message, isError = false) {
        const toast = document.getElementById('actionToast');
        const icon = document.getElementById('toastIcon');
        document.getElementById('toastTitle').innerText = title;
        document.getElementById('toastMsg').innerText = message;
        icon.className = isError
            ? 'bi bi-x-circle-fill text-danger'
            : 'bi bi-check-circle-fill text-success';
        toast.style.borderLeftColor = isError ? '#C97064' : '#7DAA8B';
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 3200);
    }

    // Controller'dan TempData ile gelen mesaj varsa göster
    (function () {
        const toast = document.getElementById('actionToast');
        if (toast.dataset.success) showToast('Başarılı', toast.dataset.success);
        else if (toast.dataset.error) showToast('Hata', toast.dataset.error, true);
    })();

    // ---------- Silme onayı (SweetAlert2) ----------
    // Kullanım: <form method="post" class="js-confirm-delete" data-item-name="..."> ... </form>
    document.addEventListener('submit', function (e) {
        const form = e.target;
        if (!form.classList.contains('js-confirm-delete') || form.dataset.confirmed) return;

        e.preventDefault();
        // Kayıt adı HTML olarak yorumlanmasın diye önce metne çevrilir (XSS önlemi)
        const safeName = document.createElement('b');
        safeName.textContent = form.dataset.itemName || 'Bu kayıt';

        Swal.fire({
            title: 'Emin misiniz?',
            html: `${safeName.outerHTML} kalıcı olarak silinecek. Bu işlem geri alınamaz.`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet, sil',
            cancelButtonText: 'Vazgeç',
            confirmButtonColor: '#C97064',
            cancelButtonColor: '#9BB7A2',
            reverseButtons: true
        }).then(result => {
            if (result.isConfirmed) {
                form.dataset.confirmed = 'true';
                form.submit();
            }
        });
    });
</script>
